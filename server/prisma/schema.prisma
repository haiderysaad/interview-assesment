generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoundType {
  APTITUDE
  TECHNICAL
  AI_INTERVIEW
}

enum QuestionType {
  SINGLE
  MULTI
}

enum SessionStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model InterviewSession {
  id          String        @id @default(uuid())
  title       String
  role        String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  status      SessionStatus @default(DRAFT)
  proctoring  Json          @default("{}")
  shareToken  String        @unique @default(dbgenerated("gen_random_uuid()"))
  createdAt   DateTime      @default(now())
  rounds      Round[]
  candidates  Candidate[]
}

model Round {
  id          String             @id @default(uuid())
  sessionId   String
  session     InterviewSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        RoundType
  order       Int
  durationMin Int
  shuffleQuestions Boolean @default(false)
  shuffleOptions   Boolean @default(false)
  questions   AptitudeQuestion[]
  technicalQuestions TechnicalQuestion[]
  attempts    Attempt[]

  @@unique([sessionId, order])
}

model AptitudeQuestion {
  id            String   @id @default(uuid())
  roundId       String
  round         Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  type          QuestionType @default(SINGLE)
  order         Int          @default(0)
  text          String
  options       String[]
  correct       Int[]
  marks         Int      @default(1)
  negativeMarks Float    @default(0)
}

model TechnicalQuestion {
  id          String   @id @default(uuid())
  roundId     String
  round       Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  title       String
  difficulty  String   @default("MEDIUM")
  statement   String
  inputFormat String   @default("")
  outputFormat String  @default("")
  starterCode Json     @default("{}")
  constraints String[] @default([])
  examples    Json     @default("[]")
  testCases   Json     @default("[]")
  marks       Int      @default(100)
  submissions TechnicalSubmission[]

  @@unique([roundId, order])
}

model TechnicalSubmission {
  id          String           @id @default(uuid())
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  questionId  String
  question    TechnicalQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  language    String
  code        String
  submittedAt DateTime         @default(now())
  suggestedCode String?
  suggestedAt DateTime?
  suggestionNote String?
  suggestionChanged Boolean?
  evaluation  Json?
  evaluatedAt DateTime?

  @@unique([candidateId, questionId])
}

model Candidate {
  id         String           @id @default(uuid())
  sessionId  String
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name       String
  email      String
  token      String           @unique @default(uuid())
  createdAt  DateTime         @default(now())
  violations Violation[]
  attempts   Attempt[]
  technicalSubmissions TechnicalSubmission[]

  @@unique([sessionId, email])
}

model Violation {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type        String
  meta        Json?
  at          DateTime  @default(now())
}

model Attempt {
  id            String    @id @default(uuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  roundId       String
  round         Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  autoSubmitted Boolean   @default(false)
  answers       Json      @default("{}")
  score         Float?
  totalMarks    Int?
  correctCount  Int?

  @@unique([candidateId, roundId])
}
